KEYSHIFT_VIEWER_TOKENS=lab-viewer-token-change-me
KEYSHIFT_ADMIN_TOKENS=lab-admin-token-change-me
KEYSHIFT_INGEST_TOKEN=lab-ingest-token-change-me
KEYSHIFT_FINGERPRINT_SECRET=lab-fingerprint-secret-change-me
